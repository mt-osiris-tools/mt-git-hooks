#!/bin/bash
# Conventional Commits validator with optional org policy extensions.
#
# Defaults:
# - Require ticket after type (feat: [LSFB-123] desc)
# - Enable generic checks only; project profile checks are opt-in

set -euo pipefail

RED='[0;31m'
YELLOW='[1;33m'
GREEN='[0;32m'
BLUE='[0;34m'
NC='[0m'

commit_msg_file=${1:-}
if [ -z "$commit_msg_file" ] || [ ! -f "$commit_msg_file" ]; then
    echo -e "${RED}Error: commit-msg hook requires a commit message file${NC}"
    exit 1
fi

commit_msg=$(cat "$commit_msg_file")
subject_line=$(printf '%s
' "$commit_msg" | sed -n '1p')

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------
require_jira_prefix=${MT_HOOK_REQUIRE_JIRA_PREFIX:-true}
jira_pattern=${MT_HOOK_JIRA_PATTERN:-LSFB-[0-9]+}
allowed_types_csv=${MT_HOOK_ALLOWED_TYPES:-feat,fix,perf,chore,refactor,docs,test,style,ci,build,revert}
enable_project_checks=${MT_HOOK_ENABLE_PROJECT_CHECKS:-false}
project_profile=${MT_HOOK_PROJECT_PROFILE:-none}

# Build regex type alternation from CSV
valid_types_regex=$(printf '%s' "$allowed_types_csv" | tr ',' '|' | tr -d '[:space:]')

has_errors=0
has_warnings=0

echo ""
echo -e "${BLUE}Validating commit message...${NC}"
echo ""

header_to_validate="$subject_line"

# Commit header:
# <type>: [ticket] <description>
if [ "$require_jira_prefix" = "true" ]; then
    cc_header_regex="^(${valid_types_regex}): \[(${jira_pattern})\] .+"
    if ! printf '%s
' "$header_to_validate" | grep -qE "$cc_header_regex"; then
        echo -e "${RED}Error: Invalid commit header${NC}"
        echo -e "${YELLOW}   Expected: <type>: [<ticket>] <description>${NC}"
        echo -e "   Example: ${GREEN}feat: [LSFB-12345] add endpoint${NC}"
        echo ""
        has_errors=1
    fi
else
    cc_header_regex="^(${valid_types_regex}): .+"
    if ! printf '%s
' "$header_to_validate" | grep -qE "$cc_header_regex"; then
        echo -e "${RED}Error: Invalid Conventional Commits header${NC}"
        echo -e "${YELLOW}   Expected: <type>: <description>${NC}"
        echo -e "   Example: ${GREEN}feat: add endpoint${NC}"
        echo ""
        has_errors=1
    fi
fi

# Breaking changes are represented with the standard footer/trailer.
if printf '%s
' "$commit_msg" | grep -qE "^BREAKING CHANGE: .+"; then
    :
elif printf '%s
' "$commit_msg" | grep -qE "^BREAKING-CHANGE: .+"; then
    echo -e "${RED}Error: Use 'BREAKING CHANGE:' (with a space), not 'BREAKING-CHANGE:'${NC}"
    echo ""
    has_errors=1
fi

# Style warnings (non-blocking)
if [ ${#subject_line} -gt 100 ]; then
    echo -e "${YELLOW}Warning: Subject line is ${#subject_line} characters (100 recommended)${NC}"
    has_warnings=1
fi

if printf '%s
' "$header_to_validate" | grep -qiE "(added|fixed|updated|changed|removed|refactored)"; then
    echo -e "${YELLOW}Warning: Prefer imperative mood in description (e.g., 'add', 'fix')${NC}"
    has_warnings=1
fi

if printf '%s
' "$header_to_validate" | grep -qE "\.$"; then
    echo -e "${YELLOW}Warning: Subject line should not end with a period${NC}"
    has_warnings=1
fi

line_count=$(printf '%s
' "$commit_msg" | wc -l)
if [ "$line_count" -gt 1 ]; then
    second_line=$(printf '%s
' "$commit_msg" | sed -n '2p')
    if [ -n "$second_line" ]; then
        echo -e "${YELLOW}Warning: Add a blank line between subject and body${NC}"
        has_warnings=1
    fi
fi

# Optional project-specific checks
if [ "$enable_project_checks" = "true" ] && [ "$project_profile" = "medtrainer" ]; then
    if git diff --cached --name-only | grep -q "symfony/src/Migrations/"; then
        echo -e "${BLUE}MedTrainer profile: migration checks enabled${NC}"

        migration_count=$(git diff --cached --name-only | grep "symfony/src/Migrations/" | grep -v "Test" | wc -l)
        if [ "$migration_count" -gt 1 ]; then
            echo -e "${YELLOW}Warning: Multiple migrations in one commit${NC}"
            has_warnings=1
        fi

        non_migration_count=$(git diff --cached --name-only | grep -v "symfony/src/Migrations/" | wc -l)
        if [ "$non_migration_count" -gt 0 ] && [ "$migration_count" -gt 0 ]; then
            echo -e "${YELLOW}Warning: Migration mixed with non-migration changes${NC}"
            has_warnings=1
        fi

        while IFS= read -r migration_file; do
            [ -z "$migration_file" ] && continue
            if git diff --cached "$migration_file" | grep -q "addSql.*SET SESSION"; then
                echo -e "${RED}Error: Deprecated migration SET SESSION pattern detected${NC}"
                has_errors=1
            fi
        done < <(git diff --cached --name-only | grep "symfony/src/Migrations/" || true)
    fi

    php_files=$(git diff --cached --name-only | grep "symfony/src/.*\.php$" | grep -v "Migration" | grep -v "Entity" | wc -l)
    test_files=$(git diff --cached --name-only | grep "symfony/tests/.*\.php$" | wc -l)
    if [ "$php_files" -gt 0 ] && [ "$test_files" -eq 0 ]; then
        echo -e "${YELLOW}Warning: No symfony/tests files staged with PHP source changes${NC}"
        has_warnings=1
    fi
fi

echo ""
if [ "$has_errors" -eq 1 ]; then
    echo -e "${RED}===============================================${NC}"
    echo -e "${RED}COMMIT REJECTED - Fix errors above${NC}"
    echo -e "${RED}===============================================${NC}"
    echo ""
    echo -e "Bypass (use sparingly): ${YELLOW}git commit --no-verify${NC}"
    echo -e "Hook docs: ${BLUE}COMMIT_FORMAT.md${NC}"
    echo ""
    exit 1
fi

if [ "$has_warnings" -gt 0 ]; then
    echo -e "${YELLOW}===============================================${NC}"
    echo -e "${YELLOW}WARNINGS DETECTED${NC}"
    echo -e "${YELLOW}===============================================${NC}"
    echo ""
fi

echo -e "${GREEN}Commit message validated${NC}"
exit 0
