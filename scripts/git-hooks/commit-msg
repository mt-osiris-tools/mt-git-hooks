#!/bin/bash
# Conventional Commits v1.0.0 validator with optional org policy extensions.
#
# Defaults:
# - Require Jira prefix before CC header (LSFB-123: feat(scope): desc)
# - Enable generic checks only; project profile checks are opt-in

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

commit_msg_file=${1:-}
if [ -z "$commit_msg_file" ] || [ ! -f "$commit_msg_file" ]; then
    echo -e "${RED}❌ Error: commit-msg hook requires a commit message file${NC}"
    exit 1
fi

commit_msg=$(cat "$commit_msg_file")
subject_line=$(printf '%s\n' "$commit_msg" | sed -n '1p')

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------
require_jira_prefix=${MT_HOOK_REQUIRE_JIRA_PREFIX:-true}
jira_pattern=${MT_HOOK_JIRA_PATTERN:-LSFB-[0-9]+}
allowed_types_csv=${MT_HOOK_ALLOWED_TYPES:-feat,fix,docs,style,refactor,perf,test,chore,revert}
enable_project_checks=${MT_HOOK_ENABLE_PROJECT_CHECKS:-false}
project_profile=${MT_HOOK_PROJECT_PROFILE:-none}

# Build regex type alternation from CSV
valid_types_regex=$(printf '%s' "$allowed_types_csv" | tr ',' '|' | tr -d '[:space:]')

has_errors=0
has_warnings=0

echo ""
echo -e "${BLUE}🔍 Validating commit message...${NC}"
echo ""

header_to_validate="$subject_line"

# Optional/required Jira prefix handling
if [ "$require_jira_prefix" = "true" ]; then
    jira_prefix_regex="^(${jira_pattern}):[[:space:]]+"
    if ! printf '%s\n' "$subject_line" | grep -qE "$jira_prefix_regex"; then
        echo -e "${RED}❌ Error: Commit message must start with Jira ticket${NC}"
        echo -e "${YELLOW}   Format: TICKET: <type>(<scope>): <description>${NC}"
        echo -e "   Example: ${GREEN}LSFB-12345: feat(api): add endpoint${NC}"
        echo ""
        has_errors=1
    else
        header_to_validate=$(printf '%s\n' "$subject_line" | sed -E "s/${jira_prefix_regex}//")
    fi
else
    jira_prefix_regex="^(${jira_pattern}):[[:space:]]+"
    if printf '%s\n' "$subject_line" | grep -qE "$jira_prefix_regex"; then
        header_to_validate=$(printf '%s\n' "$subject_line" | sed -E "s/${jira_prefix_regex}//")
    fi
fi

# Conventional Commits header:
# <type>[optional scope][optional !]: <description>
cc_header_regex="^(${valid_types_regex})(\([[:alnum:]_.\/-]+\))?(!)?: .+"
if ! printf '%s\n' "$header_to_validate" | grep -qE "$cc_header_regex"; then
    echo -e "${RED}❌ Error: Invalid Conventional Commits header${NC}"
    echo -e "${YELLOW}   Expected: <type>[optional scope][optional !]: <description>${NC}"
    echo -e "   Example: ${GREEN}feat(api)!: remove legacy auth flow${NC}"
    echo ""
    has_errors=1
fi

# Breaking change support: '!' in header OR BREAKING CHANGE: trailer in body.
# This hook validates both syntaxes as acceptable; it does not require either.
if printf '%s\n' "$header_to_validate" | grep -qE "^(${valid_types_regex})(\([[:alnum:]_.\/-]+\))?!: .+"; then
    :
elif printf '%s\n' "$commit_msg" | grep -qE "^BREAKING CHANGE: .+"; then
    :
elif printf '%s\n' "$commit_msg" | grep -qE "^BREAKING-CHANGE: .+"; then
    echo -e "${RED}❌ Error: Use 'BREAKING CHANGE:' (with a space), not 'BREAKING-CHANGE:'${NC}"
    echo ""
    has_errors=1
fi

# Style warnings (non-blocking)
if [ ${#subject_line} -gt 100 ]; then
    echo -e "${YELLOW}⚠️  Warning: Subject line is ${#subject_line} characters (100 recommended)${NC}"
    has_warnings=1
fi

if printf '%s\n' "$header_to_validate" | grep -qiE "(added|fixed|updated|changed|removed|refactored)"; then
    echo -e "${YELLOW}⚠️  Warning: Prefer imperative mood in description (e.g., 'add', 'fix')${NC}"
    has_warnings=1
fi

if printf '%s\n' "$header_to_validate" | grep -qE "\.$"; then
    echo -e "${YELLOW}⚠️  Warning: Subject line should not end with a period${NC}"
    has_warnings=1
fi

line_count=$(printf '%s\n' "$commit_msg" | wc -l)
if [ "$line_count" -gt 1 ]; then
    second_line=$(printf '%s\n' "$commit_msg" | sed -n '2p')
    if [ -n "$second_line" ]; then
        echo -e "${YELLOW}⚠️  Warning: Add a blank line between subject and body${NC}"
        has_warnings=1
    fi
fi

# Optional project-specific checks
if [ "$enable_project_checks" = "true" ] && [ "$project_profile" = "medtrainer" ]; then
    if git diff --cached --name-only | grep -q "symfony/src/Migrations/"; then
        echo -e "${BLUE}📦 MedTrainer profile: migration checks enabled${NC}"

        migration_count=$(git diff --cached --name-only | grep "symfony/src/Migrations/" | grep -v "Test" | wc -l)
        if [ "$migration_count" -gt 1 ]; then
            echo -e "${YELLOW}⚠️  Warning: Multiple migrations in one commit${NC}"
            has_warnings=1
        fi

        non_migration_count=$(git diff --cached --name-only | grep -v "symfony/src/Migrations/" | wc -l)
        if [ "$non_migration_count" -gt 0 ] && [ "$migration_count" -gt 0 ]; then
            echo -e "${YELLOW}⚠️  Warning: Migration mixed with non-migration changes${NC}"
            has_warnings=1
        fi

        while IFS= read -r migration_file; do
            [ -z "$migration_file" ] && continue
            if git diff --cached "$migration_file" | grep -q "addSql.*SET SESSION"; then
                echo -e "${RED}❌ Error: Deprecated migration SET SESSION pattern detected${NC}"
                has_errors=1
            fi
        done < <(git diff --cached --name-only | grep "symfony/src/Migrations/" || true)
    fi

    php_files=$(git diff --cached --name-only | grep "symfony/src/.*\.php$" | grep -v "Migration" | grep -v "Entity" | wc -l)
    test_files=$(git diff --cached --name-only | grep "symfony/tests/.*\.php$" | wc -l)
    if [ "$php_files" -gt 0 ] && [ "$test_files" -eq 0 ]; then
        echo -e "${YELLOW}⚠️  Warning: No symfony/tests files staged with PHP source changes${NC}"
        has_warnings=1
    fi
fi

echo ""
if [ "$has_errors" -eq 1 ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}❌ COMMIT REJECTED - Fix errors above${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "Bypass (use sparingly): ${YELLOW}git commit --no-verify${NC}"
    echo -e "Hook docs: ${BLUE}README.md${NC}"
    echo ""
    exit 1
fi

if [ "$has_warnings" -gt 0 ]; then
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}⚠️  WARNINGS DETECTED${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
fi

echo -e "${GREEN}✅ Commit message validated${NC}"
exit 0
